{
  // Copy to projects/<anything>.json (or *.local.json) and edit. MoonWalk reads every projects/*.json at startup,
  // or when you POST /api/projects/reload.
  "name": "my-game",
  "repoPath": "C:\\Users\\me\\Projects\\MyGame",
  "baseBranch": "develop",

  // Finished runs can be merged into this branch (button on a run, or "mergeToReview" under "auto") so several results are tested with
  // one checkout. Created from the base branch on the first merge. Must not start with "moonwalk/".
  "reviewBranch": "waiting-review",

  // Facts for whoever writes briefs for this project (a person or a main agent). Shown in the delegation guide at /api/guide, not sent to run agents.
  "briefingNotes": [],

  // "branch": work on a run branch inside repoPath (no second checkout; best for Unity). One run per project at a time.
  // "worktree": give each run its own git worktree folder so runs can go in parallel and your folder is never touched.
  //             For Unity a new folder means a full import before you can open it. Uses worktreeRoot below.
  "workspace": "branch",
  // "worktreeRoot": "C:\\Users\\me\\Projects\\MyGame-worktrees",   (default: wt-moonwalk beside the repository)

  // "refuse": do not start with uncommitted changes. "baseline": remember them and only commit what the agent changed.
  "dirtyPolicy": "refuse",

  // Files a tool rewrites on its own while a run is going (Unity does this to some settings assets). They are never counted as dirty,
  // never treated as the agent's work and never committed. Without this, such a file makes a run Blocked.
  "ignorePaths": [],

  // Unity: before Handover, commit the .meta files the Editor created during the run. On by default when the folder has Assets and
  // ProjectSettings; set false to switch off.
  // "commitMetaFiles": true,

  // "claude", "agy" (Gemini via Antigravity), "muse" (Muse Code), or any agent defined in agents.json.
  "agent": "claude",

  // Spec: read-only agent writes acceptance criteria. Implement: agent changes the code, MoonWalk commits it.
  // Verify: runs the commands below. Handover: writes a summary and waits for you to play the result.
  // Add "Integrate" after "Implement" for Unity projects: an agent with unity-mcp wires the scene and checks the Console.
  // The model and effort of each agent stage are chosen per run in the New run dialog; "claude.model" and "claude.effort" below
  // (and the same for agy and muse) are only the defaults.
  "stages": ["Spec", "Implement", "Verify", "Handover"],

  // The run pauses after these stages until you approve, redo with a note, or stop.
  "gates": ["Spec"],

  // Commands for the Verify stage (no shell: command plus arguments). They run in repoPath and stop at the first failure.
  "verify": [
    { "name": "compile", "command": "dotnet", "args": ["build", "-nologo"], "timeoutMinutes": 10 }
  ],

  // Extra rules appended to the agent prompt.
  "extraInstructions": [
    "Read docs/conventions.md before changing code."
  ],

  // Default automation for runs of this project (the New run dialog can change it per run). "plan" approves the gates after a stage;
  // "implementation" approves the final review and releases the workspace. With both on, a failed stage or a passed budget stops the run.
  // "mergeToReview" also merges each finished run into the review branch.
  "auto": { "plan": false, "implementation": false, "mergeToReview": false },

  // Optional spending limits for one run. When one is passed after a stage, the run waits for you (continue, retry or stop).
  // Claude is also capped inside each stage by the remaining dollars. Only Claude reports dollars; the others report tokens.
  "budget": { "maxCostUsd": 1.00, "maxTokens": 3000000 },

  "guards": {
    "allowPaths": [],
    "denyPaths": [".git/**", "**/.env*", "ProjectSettings/**"],
    "maxChangedFiles": 60,
    "maxChangedLines": 2000,
    // Globs the Integrate stage may change although denyPaths would refuse them (an Editor-side step has to save scenes and prefabs).
    "integrateAllowPaths": []
  },

  // MCP servers the claude and muse agents may use, per agent stage (Spec, Implement, Integrate). Only the listed servers are visible to that stage and
  // the project's own .mcp.json is not loaded. The claude and muse agents get them; agy and generic agents cannot (a warning says so).
  // "mcp": {
  //   "servers": {
  //     "my-knowledge": { "type": "stdio", "command": "my-mcp", "args": ["mcp", "--repo", "C:\\Users\\me\\Projects\\MyGame"] },
  //     "unity-mcp": { "type": "http", "url": "http://127.0.0.1:8080/mcp" }
  //   },
  //   "stages": { "Spec": ["my-knowledge"], "Implement": ["my-knowledge"], "Integrate": ["unity-mcp"] }
  // },

  "claude": {
    "path": "claude",
    "model": null,
    "maxTurns": 60,
    "timeoutMinutes": 45,
    "allowedTools": ["Read", "Edit", "Write", "Grep", "Glob", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"],
    "disallowedTools": ["Bash(git commit:*)", "Bash(git push:*)", "Bash(git add:*)"]
  },

  // Used when "agent" is "agy".
  "agy": {
    "path": "agy",
    "model": null,
    "mode": "accept-edits",
    "timeoutMinutes": 45,
    // In headless mode agy cannot ask for permission and a denied shell command ends its session, so by default no command is
    // allowed and the prompt tells it to use file tools only. List exact command lines to allow, or ["*"] for every command
    // (which also lets it run git commit and git push).
    "allowedCommands": []
  },

  // Used when "agent" is "muse".
  "muse": {
    "path": "muse",
    "model": null,
    "timeoutMinutes": 45,
    // Muse's shell runs inside its own sandbox, but it could still run git commit. Off by default; its file tools always work.
    "allowShell": false,
    // Load the workspace's own Muse skills and rules.
    "trustWorkspace": false
  }
}
